# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Builds android flavor, distribute to firebase based on detected branch"
  lane :distribute do
      # Get current branch name
      branch = git_branch

      puts "Starting distribution for branch: #{branch}"

      # hash to hold current build config
      config = {}

      case branch
          when 'dev'
              config = {
                flavor: 'dev',
                firebase_app_id: ENV['FIREBASE_APP_ID'],
                tester_groups: 'dev-testers',
                release_notes_path: '../release_notes_dev.txt'
              }
          when 'staging'
              config = {
                flavor: 'staging',
                firebase_app_id: ENV['FIREBASE_APP_ID'],
                tester_groups: 'qa-testers',
                release_notes_path: '../release_notes_staging.txt'
              }
          when 'master', 'main'
              config = {
                flavor: 'prod',
                firebase_app_id: ENV['FIREBASE_APP_ID'],
                tester_groups: 'internal-release-team',
                release_notes_path: '../release_notes_prod.txt'
              }
          else
              UI.user_error!("Unsupported branch for distribution. Current supported branch: 'dev', 'staging', 'master'/'main'.")
      end

      UI.user_error!("FIREBASE_APP_ID not found") if config[:firebase_app_id].to_s.empty?

      # CI Setup
      _setup_ci_environment(flavor: config[:flavor])

      # release notes
      _generate_release_notes(output_path: config[:release_notes_path])

      # distribute
      _distribute_to_firebase(config)
  end

  private_lane :_setup_ci_environment do |options|
      flavor = options[:flavor]

      firebase_creds_b64 = ENV['FIREBASE_SERVICE_ACCOUNT_B64']
      UI.user_error!("Missing FIREBASE_SERVICE_ACCOUNT_B64 environment variable") if firebase_creds_b64.to_s.empty?

      credentials_path = "/tmp/firebase_credentials.json"
      File.open(credentials_path, "wb") { |file| file.write(Base64.decode64(firebase_creds_b64)) }
      ENV['FIREBASE_APP_DISTRIBUTION_SERVICE_CREDENTIALS_FILE'] = credentials_path
      puts "CREATED firebase service account credentials at #{credentials_path}"
  end

  private_lane :_generate_release_notes do |options|
      pr_description = ENV['PR_DESCRIPTION']
      release_notes = (pr_description.nil? || pr_description.strip.empty?) ? "Automated build from CI." : pr_description

      output_path = File.expand_path(options[:output_path], __dir__)
      File.write(output_path, release_notes)
      puts "CREATED release notes and saved to #{options[:output_path]}"
  end

private_lane :_auto_increment_version do |options|
  flavor = options[:flavor]
  firebase_app_id = options[:firebase_app_id]
  gradle_file = File.join(__dir__, "../build.gradle.kts")

  begin
    latest_release = firebase_app_distribution_get_latest_release(
      app: firebase_app_id,
      service_credentials_file: ENV['FIREBASE_APP_DISTRIBUTION_SERVICE_CREDENTIALS_FILE']
    )
    current_version_name = latest_release[:displayVersion]
    current_version_code = latest_release[:buildVersion].to_i
    puts "Fetched from Firebase: #{current_version_name} (#{current_version_code})"
  rescue => e
    puts "No Firebase release found, reading from Gradle: #{e.message}"
    content = File.read(gradle_file)
    current_version_code = content.match(/versionCode\s*=\s*(\d+)/)[1].to_i
    current_version_name = content.match(/versionName\s*=\s*"([^"]+)"/)[1]
    puts "Read from Gradle: #{current_version_name} (#{current_version_code})"
  end

  new_version_code = current_version_code + 1

  # Analyze Git diff
  diff_stats = sh("git diff --shortstat HEAD~5 HEAD", log: false).strip rescue ""
  insertions = diff_stats.match(/(\d+) insertion/)&.captures&.first.to_i
  deletions = diff_stats.match(/(\d+) deletion/)&.captures&.first.to_i
  files_changed = diff_stats.match(/(\d+) file/)&.captures&.first.to_i
  total_changes = insertions + deletions

  version_parts = current_version_name.split(".")
  major = version_parts[0].to_i
  minor = version_parts[1].to_i
  patch = version_parts[2].to_i

  if total_changes > 1000 || files_changed > 50
    major += 1
    minor = 0
    patch = 0
    puts "MAJOR bump: #{total_changes} lines, #{files_changed} files"
  elsif total_changes > 300 || files_changed > 15
    minor += 1
    patch = 0
    puts "MINOR bump: #{total_changes} lines, #{files_changed} files"
  else
    patch += 1
    puts "PATCH bump: #{total_changes} lines, #{files_changed} files"
  end

  new_version_name = "#{major}.#{minor}.#{patch}"

  content = File.read(gradle_file)
  content.gsub!(/versionCode\s*=\s*\d+/, "versionCode = #{new_version_code}")
  content.gsub!(/versionName\s*=\s*"[^"]+"/, "versionName = \"#{new_version_name}\"")
  File.write(gradle_file, content)

  puts "Updated version: #{new_version_name} (#{new_version_code})"
end

  private_lane :_distribute_to_firebase do |options|
       _auto_increment_version(
              flavor: options[:flavor],
              firebase_app_id: options[:firebase_app_id]
       )

      gradle(
          task: "bundle#{options[:flavor].capitalize}Release",
          project_dir: '../'
      )

      aab_path = "build/outputs/bundle/#{options[:flavor]}Release/composeApp-#{options[:flavor]}-release.aab"
      release_notes_path = File.expand_path(options[:release_notes_path], __dir__)

      firebase_app_distribution(
        app: options[:firebase_app_id],
        service_credentials_file: ENV['FIREBASE_APP_DISTRIBUTION_SERVICE_CREDENTIALS_FILE'],
        groups: options[:tester_groups],
        release_notes_file: release_notes_path,
        android_artifact_type: "AAB",
        android_artifact_path: aab_path,
        debug: true
      )

      puts "SUCCESS - Distributed #{options[:flavor]} build to Firebase App Distribution"
   end
end


